{
  "name": "SLEssentials",
  "version": "1.1.0",
  "summary": "SLEssentials is a set of Swift utilities for iOS and tvOS.",
  "description": "SLEssentials is a collection of Swift utilities, extensions, and lightweight managers\nused in most iOS applications. It includes tools for networking, keyboard handling,\napp state observation, loading indicators, and more.",
  "homepage": "https://github.com/swifty-labs/SLEssentials",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "vukasin-popovic": "vukasin.popovic@swiftylabs.io",
    "slobodan-ristic": "slobodan.ristic@swiftylabs.io"
  },
  "source": {
    "git": "https://github.com/swifty-labs/SLEssentials.git",
    "tag": "1.1.0",
    "submodules": true
  },
  "platforms": {
    "ios": "13.0",
    "tvos": "15.0"
  },
  "swift_versions": "5.7",
  "default_subspecs": [
    "Core",
    "AuthenticationManager",
    "Networking"
  ],
  "subspecs": [
    {
      "name": "Core",
      "source_files": [
        "Sources/SLEssentials/Utilities/**/*.swift",
        "Sources/iOS/Utilities/**/*.swift",
        "Sources/iOS/Managers/KeyboardManager/*.swift",
        "Sources/iOS/Managers/ImagePicker/*.swift",
        "Sources/SLEssentials/Logger/*.swift",
        "Sources/SLEssentials/Managers/TableViewDataSource/*.swift",
        "Sources/SLEssentials/Managers/AppStateObserver/*.swift",
        "Sources/SLEssentials/Managers/LoadingIndicator/*.swift",
        "Sources/SLEssentials/Managers/ImageLoader/*.swift",
        "Sources/SLEssentials/Managers/TextTapManager/*.swift",
        "Sources/SLEssentials/Managers/Debouncer/*.swift",
        "Sources/SLEssentials/Managers/LinkedList/*.swift",
        "Sources/SLEssentials/Managers/Throttler/*.swift"
      ],
      "dependencies": {
        "TinyConstraints": [

        ]
      }
    },
    {
      "name": "AuthenticationManager",
      "source_files": "Sources/iOS/Managers/AuthenticationManager/*.swift"
    },
    {
      "name": "Networking",
      "source_files": [
        "Sources/SLEssentials/Networking/*.swift",
        "Sources/SLEssentials/Utilities/**/*.swift",
        "Sources/iOS/Utilities/**/*.swift"
      ],
      "dependencies": {
        "Alamofire": [

        ]
      }
    },
    {
      "name": "tvOS",
      "source_files": [
        "Sources/SLEssentials/Logger/*.swift",
        "Sources/SLEssentials/Utilities/**/*.swift",
        "Sources/SLEssentials/Managers/TextTapManager/*.swift"
      ]
    }
  ],
  "swift_version": "5.7"
}
